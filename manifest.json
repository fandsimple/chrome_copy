{
  "manifest_version": 2,
  "name": "文章复制工具",
  "version": "1.1.0",
  "description": "文章内容提取与AI智能摘要 - 支持CSDN、博客园、掘金、简书等平台，纯本地运行，保护隐私安全",
  "icons": {
    "16": "./img/icon.png",
    "48": "./img/icon.png",
    "128": "./img/icon.png"
  },
  "browser_action": {
    "default_icon": "./img/icon.png",
    "default_title": "文章复制工具 - AI智能摘要",
    "default_popup": "./html/index.html"
  },
  "web_accessible_resources": [
    "js/utils/logger.js",
    "js/utils/content-enhancer.js",
    "js/ai/summarizer.js",
    "js/export/export-manager.js",
    "js/baseJs/jquery-2.2.1.js",
    "js/baseJs/turndown.js",
    "js/baseJs/FileSaver.js",
    "js/baseJs/jquery.wordexport.js",
    "js/export/csdn.js",
    "js/export/juejin.js",
    "js/export/bokeyuan.js",
    "js/export/jianshu.js",
    "js/export/dgstack.js",
    "js/export/bdwk.js",
    "js/export/local.js",
    "js/export/local1.js",
    "js/contentJs/csdn.js",
    "js/contentJs/juejin.js",
    "js/contentJs/bokeyuan.js",
    "js/contentJs/jianshu.js",
    "js/contentJs/dgstack.js",
    "js/contentJs/bdwk.js",
    "js/contentJs/local.js",
    "html/test.html"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://blog.csdn.net/*",
        "https://juejin.im/post/*",
        "https://juejin.cn/post/*",
        "https://www.cnblogs.com/*",
        "https://www.jianshu.com/*",
        "https://www.dgstack.cn/*",
        "https://wenku.baidu.com/view/*",
        "http://127.0.0.1:8000/*"
      ],
      "js": [
        "./js/contentJs/content.js"
      ],
      "css": [
        "./css/bootstrap.min.css"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ]
}
