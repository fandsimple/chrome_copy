{
  "manifest_version": 3,
  "name": "Smart Article Extractor",
  "version": "3.1.0",
  "description": "AI-powered intelligent article extraction and conversion tool with advanced parsing, content enhancement, and multi-format export",
  "icons": {
    "16": "img/icon.png",
    "32": "img/icon.png",
    "48": "img/icon.png",
    "128": "img/icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "contextMenus",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [
    "https://blog.csdn.net/*",
    "https://juejin.cn/*",
    "https://juejin.im/*",
    "https://www.cnblogs.com/*",
    "https://www.jianshu.com/*",
    "https://zhuanlan.zhihu.com/*",
    "https://www.zhihu.com/*",
    "https://segmentfault.com/*",
    "https://www.dgstack.cn/*",
    "https://wenku.baidu.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "img/icon.png",
      "32": "img/icon.png"
    },
    "default_title": "Smart Article Extractor",
    "default_popup": "html/index.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "js/baseJs/jquery-2.2.1.js",
        "js/baseJs/turndown.js",
        "core/constants.js",
        "core/parser/ai-parser.js",
        "core/parser/content-enhancer.js",
        "core/platform/custom-rules-manager.js",
        "core/platform/template-engine.js",
        "core/platform/export-manager.js",
        "core/platform/batch-manager.js",
        "core/platform/error-handler.js",
        "content-scripts/index.js"
      ],
      "css": [
        "css/index.css",
        "content-scripts/styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "options_page": "html/index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "js/baseJs/*.js",
        "core/*.js",
        "core/parser/*.js",
        "core/platform/*.js",
        "content-scripts/*.js",
        "html/*.html",
        "css/*.css",
        "img/*.png",
        "img/*.jpg",
        "img/*.gif",
        "img/*.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
